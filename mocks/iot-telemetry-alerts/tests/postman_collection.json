{
  "info": {
    "_postman_id": "iot-telemetry-alerts-001",
    "name": "IoT Telemetry Alerts",
    "description": "Time-series streaming, anomaly detection, and webhook routing tests for DataTrucker IoT pipeline.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "HOST", "value": "http://localhost:8080" },
    { "key": "KEYCLOAK_HOST", "value": "http://localhost:8081" },
    { "key": "ACCESS_TOKEN", "value": "" }
  ],
  "item": [
    {
      "name": "Health & Auth",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Health response structure', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('reqCompleted');",
                  "    pm.expect(json.data).to.have.property('db');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{HOST}}/api/v1/statuschecks/healthcheck"
          }
        },
        {
          "name": "Obtain Operator Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token obtained', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.collectionVariables.set('ACCESS_TOKEN', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "iot-telemetry-api" },
                { "key": "client_secret", "value": "iot-telemetry-secret-change-me" },
                { "key": "username", "value": "iot-operator" },
                { "key": "password", "value": "iot-operator-pass" }
              ]
            },
            "url": "{{KEYCLOAK_HOST}}/realms/IoT-Telemetry/protocol/openid-connect/token"
          }
        },
        {
          "name": "Unauthorized - No Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"deviceId\":\"sensor-001\",\"timestamp\":\"2026-08-25T18:00:00Z\",\"metrics\":{\"temp\":22}}"
            },
            "url": "{{HOST}}/api/v1/jobs/telemetry-ingest"
          }
        },
        {
          "name": "Unauthorized - Invalid Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 with invalid token', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer invalid-token-xyz" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"deviceId\":\"sensor-001\",\"timestamp\":\"2026-08-25T18:00:00Z\",\"metrics\":{\"temp\":22}}"
            },
            "url": "{{HOST}}/api/v1/jobs/telemetry-ingest"
          }
        }
      ]
    },
    {
      "name": "Telemetry Ingest",
      "item": [
        {
          "name": "Ingest Valid Telemetry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ingest succeeds', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().reqCompleted).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"sensor-warehouse-a-0042\",\n  \"timestamp\": \"2026-08-25T18:00:00.000Z\",\n  \"metrics\": { \"temperature_c\": 23.4, \"humidity_pct\": 58.2 },\n  \"location\": { \"lat\": 43.6532, \"lon\": -79.3832 }\n}"
            },
            "url": "{{HOST}}/api/v1/jobs/telemetry-ingest"
          }
        },
        {
          "name": "Negative - Missing deviceId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validation rejected', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"timestamp\":\"2026-08-25T18:00:00Z\",\"metrics\":{\"temp\":22}}"
            },
            "url": "{{HOST}}/api/v1/jobs/telemetry-ingest"
          }
        },
        {
          "name": "Negative - Invalid deviceId Pattern",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid deviceId rejected', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"deviceId\":\"!!bad!!\",\"timestamp\":\"2026-08-25T18:00:00Z\",\"metrics\":{\"temp\":22}}"
            },
            "url": "{{HOST}}/api/v1/jobs/telemetry-ingest"
          }
        }
      ]
    },
    {
      "name": "Anomaly Detection",
      "item": [
        {
          "name": "Detect Critical Anomaly",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Anomaly detection responds', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"sensor-warehouse-a-0042\",\n  \"metric\": \"temperature_c\",\n  \"value\": 89.7,\n  \"baseline\": { \"mean\": 23.1, \"stddev\": 1.8 },\n  \"thresholdSigma\": 3\n}"
            },
            "url": "{{HOST}}/api/v1/jobs/anomaly-detect"
          }
        },
        {
          "name": "Negative - Missing Metric",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing metric rejected', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"deviceId\":\"sensor-001\",\"value\":50}"
            },
            "url": "{{HOST}}/api/v1/jobs/anomaly-detect"
          }
        },
        {
          "name": "Negative - thresholdSigma Out of Range",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Out of range sigma rejected', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"deviceId\":\"sensor-001\",\"metric\":\"temp\",\"value\":50,\"thresholdSigma\":10}"
            },
            "url": "{{HOST}}/api/v1/jobs/anomaly-detect"
          }
        }
      ]
    },
    {
      "name": "Alert Dispatch",
      "item": [
        {
          "name": "Dispatch Webhook Alert",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Webhook dispatch accepted', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alertId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"severity\": \"critical\",\n  \"webhookUrl\": \"http://localhost:1080/alert\",\n  \"payload\": { \"deviceId\": \"sensor-001\", \"metric\": \"temperature_c\", \"value\": 89.7 }\n}"
            },
            "url": "{{HOST}}/api/v1/jobs/alert-dispatch"
          }
        },
        {
          "name": "Negative - Invalid Severity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid severity rejected', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"alertId\":\"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\"severity\":\"emergency\",\"webhookUrl\":\"http://localhost:1080/alert\"}"
            },
            "url": "{{HOST}}/api/v1/jobs/alert-dispatch"
          }
        }
      ]
    }
  ]
}
